{
  "name": "xelar-notify",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "workspaces": ["apps/*"],
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:generate": "ts-node -r tsconfig-paths/register scripts/migration-generate.ts",
    "migration:run": "typeorm-ts-node-commonjs -d libs/database/src/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d libs/database/src/data-source.ts migration:revert",
    "start:dev:api": "nest start api --watch",
    "start:dev:webhook-receiver": "nest start webhook-receiver --watch",
    "start:dev:notification-worker": "nest start notification-worker --watch",
    "start:dev:discord-bot": "nest start discord-bot --watch",
    "start:dev:docker": "docker compose -f docker-compose.dev.yml up -d",
    "start:dev": "concurrently -n api,receiver,discord,notification-worker -c blue,green,magenta,cyan \"npm run start:dev:api\" \"npm run start:dev:webhook-receiver\" \"npm run start:dev:discord-bot\" \"npm run start:dev:notification-worker\"",
    "build:api": "nest build api",
    "build:webhook-receiver": "nest build webhook-receiver",
    "build:notification-worker": "nest build notification-worker",
    "build:discord-bot": "nest build discord-bot",
    "build:migrate": "nest build migrate",
    "build:all": "npm run build:api && npm run build:webhook-receiver && npm run build:discord-bot && npm run build:notification-worker",
    "start:api": "node dist/apps/api/main",
    "start:webhook-receiver": "node dist/apps/webhook-receiver/main",
    "start:notification-worker": "node dist/apps/notification-worker/main",
    "start:discord-bot": "node dist/apps/discord-bot/main"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^1.0.3",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/rpc(|/.*)$": "<rootDir>/libs/rpc/src/$1",
      "^@lib/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@libs/queue/queue(|/.*)$": "<rootDir>/libs/queue/src/$1",
      "^@libs/shared/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^lib/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^redis/redis(|/.*)$": "<rootDir>/libs/redis/src/$1"
    }
  }
}
